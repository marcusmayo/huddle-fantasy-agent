# Never commit real credentials. Copy this file to .env locally.
FANTASYPROS_API_KEY=
FANTASYPROS_BASE_URL=https://api.fantasypros.com/public/v2/json

# Yahoo OAuth values are only needed after access is approved.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:8787/auth/yahoo/callback
YAHOO_LEAGUE_KEY=
YAHOO_TEAM_KEY=

# Huddle runtime
HUDDLE_PORT=8787
HUDDLE_HOST=127.0.0.1
HUDDLE_STATE_FILE=./data/huddle-state.json
HUDDLE_LEAGUE_CONFIG=./config/leagues/yahoo-example.json
# The demo defaults to a three-league portfolio. Remove this line for single-league mode.
HUDDLE_LEAGUE_REGISTRY=./config/leagues/registry.example.json
HUDDLE_PLAYER_FIXTURE=./config/fixtures/demo-players.json
# Optional compiled FantasyPros snapshot shared by fleet members.
HUDDLE_PLAYER_SNAPSHOT_FILE=
HUDDLE_SEASON=2026
HUDDLE_INSTANCE_NAME=huddle-local
HUDDLE_AUDIT_FILE=./data/audit/fleet-commands.jsonl
HUDDLE_FANTASYPROS_SYNC_ENABLED=true
FANTASYPROS_CACHE_DIR=./data/fantasypros-cache

# Player images are fail-closed. Enable only after documenting a license for every host.
HUDDLE_PLAYER_IMAGES_ENABLED=false
HUDDLE_PLAYER_IMAGE_ALLOWED_HOSTS=
