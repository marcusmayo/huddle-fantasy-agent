# Never commit real credentials. Copy this file to .env locally.
FANTASYPROS_API_KEY=
FANTASYPROS_BASE_URL=https://api.fantasypros.com/public/v2/json
# Huddle's conservative local guard leaves 26 of the free tier's 50 daily calls unused.
FANTASYPROS_DAILY_REQUEST_BUDGET=24

# Optional second-opinion rankings through Tank01 on RapidAPI. The default local
# budget permits roughly one cached refresh per day while staying far below the
# documented 1,000-request monthly free-tier cap.
TANK01_API_KEY=
TANK01_API_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
TANK01_BASE_URL=https://tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
TANK01_ADP_PATH=/getNFLADP
TANK01_MONTHLY_REQUEST_BUDGET=40
TANK01_CACHE_DIR=./data/tank01-cache

# Sleeper trends are read-only and need no key. The player map is cached for at
# least 24 hours in accordance with Sleeper's API guidance.
HUDDLE_SLEEPER_TRENDS_ENABLED=true
SLEEPER_BASE_URL=https://api.sleeper.app/v1
SLEEPER_TREND_LOOKBACK_HOURS=24
SLEEPER_TREND_LIMIT=100
SLEEPER_CACHE_DIR=./data/sleeper-cache

# Screenshot analysis is opt-in and is sent transiently through OpenRouter only after confirmation.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.6

# Yahoo OAuth values are only needed after access is approved.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:8787/auth/yahoo/callback
YAHOO_LEAGUE_KEY=
YAHOO_TEAM_KEY=

# Huddle runtime
HUDDLE_PORT=8787
HUDDLE_HOST=127.0.0.1
HUDDLE_STATE_FILE=./data/huddle-state.json
HUDDLE_LEAGUE_CONFIG=./config/leagues/yahoo-example.json
# The demo defaults to a three-league portfolio. Remove this line for single-league mode.
HUDDLE_LEAGUE_REGISTRY=./config/leagues/registry.example.json
# Dashboard-created leagues persist in this ignored data directory and are
# merged with the registry above on every restart. Keep disabled on an
# internet-facing instance unless an authenticated access proxy protects it.
HUDDLE_LEAGUE_ONBOARDING_ENABLED=true
HUDDLE_LEAGUE_ONBOARDING_DIR=./data/leagues
HUDDLE_MANAGED_LEAGUE_REGISTRY=./data/leagues/registry.managed.json
HUDDLE_PLAYER_FIXTURE=./config/fixtures/demo-players.json
# Optional compiled FantasyPros snapshot shared by fleet members.
HUDDLE_PLAYER_SNAPSHOT_FILE=
HUDDLE_SEASON=2026
HUDDLE_INSTANCE_NAME=huddle-local
HUDDLE_AUDIT_FILE=./data/audit/fleet-commands.jsonl
HUDDLE_FANTASYPROS_SYNC_ENABLED=true
HUDDLE_FANTASYPROS_AUTO_REFRESH_ENABLED=true
# One complete six-position refresh costs up to 12 FantasyPros requests.
HUDDLE_FANTASYPROS_REFRESH_INTERVAL_HOURS=24
FANTASYPROS_CACHE_DIR=./data/fantasypros-cache

# Player images are fail-closed. Enable only after documenting a license for every host.
HUDDLE_PLAYER_IMAGES_ENABLED=false
HUDDLE_PLAYER_IMAGE_ALLOWED_HOSTS=
