# Never commit real credentials. Copy this file to .env locally.
FANTASYPROS_API_KEY=
FANTASYPROS_BASE_URL=https://api.fantasypros.com/public/v2/json
# Huddle's conservative local guard leaves 26 of the free tier's 50 daily calls unused.
FANTASYPROS_DAILY_REQUEST_BUDGET=24

# Optional second-opinion rankings through Tank01 on RapidAPI. The default local
# budget permits roughly one cached refresh per day while staying far below the
# documented 1,000-request monthly free-tier cap.
TANK01_API_KEY=
TANK01_API_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
TANK01_BASE_URL=https://tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
TANK01_ADP_PATH=/getNFLADP
TANK01_MONTHLY_REQUEST_BUDGET=40
TANK01_CACHE_DIR=./data/tank01-cache

# Sleeper trends are read-only and need no key. The player map is cached for at
# least 24 hours in accordance with Sleeper's API guidance.
HUDDLE_SLEEPER_TRENDS_ENABLED=true
SLEEPER_BASE_URL=https://api.sleeper.app/v1
SLEEPER_TREND_LOOKBACK_HOURS=24
SLEEPER_TREND_LIMIT=100
SLEEPER_CACHE_DIR=./data/sleeper-cache

# Screenshot analysis is opt-in and is sent transiently through OpenRouter only after confirmation.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.6

# Yahoo OAuth values enable account-first league discovery after access is approved.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:8787/auth/yahoo/callback
YAHOO_AUTH_URL=https://api.login.yahoo.com/oauth2/request_auth
YAHOO_TOKEN_URL=https://api.login.yahoo.com/oauth2/get_token
YAHOO_LEAGUE_KEY=
YAHOO_TEAM_KEY=
# Keep OAuth disabled until Yahoo supplies approved credentials and the exact
# redirect URI is registered. Before enabling, generate a key with:
# openssl rand -base64 32
HUDDLE_YAHOO_OAUTH_ENABLED=false
HUDDLE_TOKEN_ENCRYPTION_KEY=
HUDDLE_YAHOO_TOKEN_FILE=./data/secrets/yahoo-tokens.enc.json
# Yahoo draft-result reads start automatically only for sessions created in
# Yahoo source mode. The official portal does not publish a numeric request
# ceiling; confirm the 15-second cadence with Yahoo before draft day.
HUDDLE_YAHOO_DRAFT_AUTO_SYNC_ENABLED=true
HUDDLE_YAHOO_DRAFT_POLL_SECONDS=15
HUDDLE_YAHOO_DRAFT_MINIMUM_CROSSWALK_COVERAGE=0.80
# Preflight also requires enough QB/RB/WR/TE/K/DEF depth to cover every
# configured starter slot plus this percentage buffer.
HUDDLE_DRAFT_POSITION_DEPTH_BUFFER_PERCENT=20
# Runs three read-only Yahoo endpoint checks for every verified league whenever
# npm run preflight executes. No raw response or state mutation is retained.
HUDDLE_PREFLIGHT_YAHOO_REHEARSAL_ENABLED=true
# Weekly automation reads Yahoo into an expiring in-memory preview. It does not
# write raw responses or submit/persist a Yahoo transaction.
HUDDLE_YAHOO_WEEKLY_AUTO_REFRESH_ENABLED=true
HUDDLE_YAHOO_WEEKLY_REFRESH_HOURS=24
HUDDLE_YAHOO_WEEKLY_PREVIEW_TTL_MINUTES=60
# Page through the Yahoo free-agent pool instead of evaluating only its first
# page. The hard cap controls request volume for one league refresh.
HUDDLE_YAHOO_WEEKLY_PLAYER_PAGE_SIZE=100
HUDDLE_YAHOO_WEEKLY_MAX_AVAILABLE_PLAYERS=500
# Explicitly imported weekly history retains the ranked claim plan and only the
# highest-value candidates needed for later review/reruns.
HUDDLE_WEEKLY_PERSISTED_CANDIDATE_LIMIT=25
# Optional emergency override when Yahoo discovery does not report current_week.
HUDDLE_WEEK_OVERRIDE=
# Draft preflight fails when the shared player evidence is older than this.
HUDDLE_OPERATIONS_MAXIMUM_EVIDENCE_AGE_HOURS=36
# Agreement-derived safety ceiling. Values above 30 are clamped to 30 days.
HUDDLE_YAHOO_EVIDENCE_RETENTION_DAYS=30
# Enables local purge/disconnect routes. Keep false behind an internet-facing proxy.
HUDDLE_COMPLIANCE_MAINTENANCE_ENABLED=true

# Weekly management uses the same Yahoo OAuth connection. Live reads become an
# expiring in-memory preview; persisted history remains an explicit manual import
# until Yahoo confirms what normalized league history Huddle may retain.

# Huddle runtime
HUDDLE_PORT=8787
HUDDLE_HOST=127.0.0.1
HUDDLE_STATE_FILE=./data/huddle-state.json
HUDDLE_LEAGUE_CONFIG=./config/leagues/yahoo-example.json
# The demo defaults to a three-league portfolio. Remove this line for single-league mode.
HUDDLE_LEAGUE_REGISTRY=./config/leagues/registry.example.json
# Dashboard-created leagues persist in this ignored data directory and are
# merged with the registry above on every restart. Keep disabled on an
# internet-facing instance unless an authenticated access proxy protects it.
HUDDLE_LEAGUE_ONBOARDING_ENABLED=true
HUDDLE_LEAGUE_ONBOARDING_DIR=./data/leagues
HUDDLE_MANAGED_LEAGUE_REGISTRY=./data/leagues/registry.managed.json
HUDDLE_PLAYER_FIXTURE=./config/fixtures/demo-players.json
# Persist the reconciled player pool so a separate preflight process and a
# restart see the same Yahoo player crosswalk used by the live draft.
HUDDLE_PLAYER_SNAPSHOT_FILE=./data/player-pool.json
HUDDLE_SEASON=2026
HUDDLE_INSTANCE_NAME=huddle-local
HUDDLE_AUDIT_FILE=./data/audit/fleet-commands.jsonl
HUDDLE_FANTASYPROS_SYNC_ENABLED=true
HUDDLE_FANTASYPROS_AUTO_REFRESH_ENABLED=true
# One complete refresh costs up to 13 FantasyPros requests: six ranking calls,
# six projection calls, and one player-metadata/external-ID call.
HUDDLE_FANTASYPROS_REFRESH_INTERVAL_HOURS=24
FANTASYPROS_CACHE_DIR=./data/fantasypros-cache

# Player images are fail-closed. Enable only after documenting a license for every host.
HUDDLE_PLAYER_IMAGES_ENABLED=false
HUDDLE_PLAYER_IMAGE_ALLOWED_HOSTS=
