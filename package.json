{
  "name": "huddle-fantasy-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only fantasy football draft and weekly decision agent.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "node scripts/build-clock-assets.cjs",
    "prestart:live": "node scripts/build-clock-assets.cjs",
    "build:clock": "node scripts/build-clock-assets.cjs",
    "start": "node src/server.js",
    "start:live": "node src/server.js",
    "draft:local": "node scripts/local-draft-supervisor.cjs",
    "preflight": "node scripts/operations-preflight.js",
    "preflight:json": "node scripts/operations-preflight.js --json",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "verify:core": "bash scripts/verify-core.sh scripts",
    "check": "npm run verify:core && npm test"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "js-yaml": "^4.1.0",
    "tesseract.js": "6.0.1",
    "ws": "^8.18.3"
  }
}
