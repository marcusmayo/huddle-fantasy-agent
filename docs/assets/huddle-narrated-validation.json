  "narration_timing": [
    {
      "start": 0.65,
      "end": 4.2739,
      "text": "Every season begins with a choice. Make yours count.",
      "original_seconds": 3.627,
      "time_compression": 1.0
    },
    {
      "start": 6.3,
      "end": 11.0194,
      "text": "This is Huddle. Connect Yahoo. Your leagues. Your rules. One command center.",
      "original_seconds": 4.722,
      "time_compression": 1.0
    },
    {
      "start": 13.25,
      "end": 18.7751,
      "text": "As the draft unfolds, compare your best pick, the safer choice, and the upside play.",
      "original_seconds": 5.5284,
      "time_compression": 1.0
    },
    {
      "start": 21.25,
      "end": 27.1562,
      "text": "Multiple data sources. Clear reasoning. Rankings built by rules, not guesswork.",
      "original_seconds": 5.9109,
      "time_compression": 1.0
    },
    {
      "start": 28.25,
      "end": 33.2304,
      "text": "After draft day, review scores, standings, and the points left on your bench.",
      "original_seconds": 4.9831,
      "time_compression": 1.0
    },
    {
      "start": 36.3,
      "end": 40.4354,
      "text": "Find the next addition. Weigh the trade-offs. Or hold your ground.",
      "original_seconds": 4.139,
      "time_compression": 1.0
    },
    {
      "start": 43.3,
      "end": 47.429,
      "text": "Before the clock starts, check draft readiness, right inside the app.",
      "original_seconds": 4.1318,
      "time_compression": 1.0
    },
    {
      "start": 50.25,
      "end": 53.8572,
      "text": "Huddle reads the field. You make every move in Yahoo.",
      "original_seconds": 3.6127,
      "time_compression": 1.0
    },
    {
      "start": 56.25,
      "end": 58.0608,
      "text": "Huddle. Your league. Your call.",
      "original_seconds": 1.8149,
      "time_compression": 1.0
    }
  ],
